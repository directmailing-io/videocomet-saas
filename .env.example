# ── Database (PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgres://videocomet:CHANGE_ME@localhost:5432/videocomet

# ── Redis (BullMQ Queue + Pub/Sub) ──────────────────────────────────────
REDIS_URL=redis://default:CHANGE_ME@localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=videocomet_session
COOKIE_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ── App ─────────────────────────────────────────────────────────────────
APP_URL=https://app.videocomet.de
ADMIN_SEED_EMAIL=info@daniel-kurzeja.de
ADMIN_SEED_PASSWORD=CHANGE_ME_BEFORE_FIRST_DEPLOY

# ── Bunny.net Stream (Video) ────────────────────────────────────────────
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=670919
BUNNY_STREAM_CDN_HOSTNAME=vz-9c44b476-07a.b-cdn.net
# Token-Auth-Key der Stream-Pullzone. Wenn gesetzt, signiert sign-url.ts die
# HLS/MP4-URLs mit ?token=&expires=. Pflicht, sobald in Bunny "Token
# Authentication" für die Library aktiv ist (sonst liefert die CDN 403).
BUNNY_STREAM_TOKEN_AUTH_KEY=

# ── Bunny.net Storage (PDF) ─────────────────────────────────────────────
BUNNY_STORAGE_ZONE=videocomet-pdf
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_READONLY_KEY=
BUNNY_STORAGE_CDN_HOSTNAME=videocomet-pdf.b-cdn.net

# ── Mail (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── Worker Tooling-Pfade (auf Server) ───────────────────────────────────
CHROMIUM_PATH=/usr/bin/chromium-browser
FFMPEG_PATH=/usr/bin/ffmpeg
LIBREOFFICE_PATH=/usr/bin/libreoffice
GHOSTSCRIPT_PATH=/usr/bin/gs

# ── PDF Cleanup ─────────────────────────────────────────────────────────
PDF_TTL_DAYS=7

# ── CRM-Integration ─────────────────────────────────────────────────────
# Master-Key für AES-256-GCM-Verschlüsselung der CRM-API-Keys.
CRM_KEY_SECRET=  # 64-hex; generate with: openssl rand -hex 32
